{
  "name": "mediaforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:api": "pnpm --filter api run build",
    "dev:api": "pnpm --filter api run start:dev",
    "test:api": "pnpm --filter api --fail-if-no-match run test:harness",
    "test:worker": "uv run --project workers/media pytest workers/media/tests/test_harness.py -q"
  }
}
